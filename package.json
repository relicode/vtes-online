    "@mui/material-nextjs": "^7.3.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "ioredis": "^5.9.3",
    "lodash-es": "^4.17.23",
    "material-ui-confirm": "^4.0.0",
    "next": "16.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "three": "^0.182.0"
